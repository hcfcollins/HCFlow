#!/bin/sh
# Bumps the app's version number (shown small in the header) on EVERY commit,
# so every update pushed out gets the next number automatically — no one has
# to remember. Enabled via: git config core.hooksPath .githooks
FILE="src/version.json"
[ -f "$FILE" ] || echo '{ "version": 0 }' > "$FILE"
CURRENT=$(sed -E 's/[^0-9]*([0-9]+).*/\1/' "$FILE" | head -1)
NEXT=$((CURRENT + 1))
printf '{ "version": %s }\n' "$NEXT" > "$FILE"
git add "$FILE"
